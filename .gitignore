cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment variables
.env
.env.local
.env.*.local
*.env

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.cursor/

# Database
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/
*.log.*

# Uploads & Generated Files
backend/data/uploads/*
backend/data/reports/*
!backend/data/uploads/.gitkeep
!backend/data/reports/.gitkeep

# ML Models
ml-engine/models/fine-tuned/*
!ml-engine/models/fine-tuned/.gitkeep
*.pt
*.pth
*.onnx

# Temporary files
*.tmp
temp/
tmp/

# Test coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
.cache/
.parcel-cache/

# Frontend build
frontend/dist/
frontend/build/

# Docker
*.pid
*.seed
*.pid.lock

# OS
Thumbs.db
Desktop.ini

# Secrets & Keys
secrets/
*.key
*.pem
*.p12
*.crt
credentials.json

# Large files (not in git)
*.pdf
*.docx
*.xlsx
*.csv

# OCR test data
ocr-adapters/tests/sample_invoices/*
!ocr-adapters/tests/sample_invoices/.gitkeep
EOF