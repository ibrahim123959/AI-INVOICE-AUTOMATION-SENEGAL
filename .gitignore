cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/
.pytest_cache/

# Environment variables
.env
.env.local
*.env

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints

# Data & Models
ml-engine/data/
*.h5
*.pkl
*.pth
*.onnx

# Uploads & Temp
backend/uploads/
backend/temp/
*.pdf
*.jpg
*.png

# Logs
*.log
logs/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
.cache/

# Docker
*.pid
*.seed
*.pid.lock

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Secrets
secrets/
*.key
*.pem
EOF