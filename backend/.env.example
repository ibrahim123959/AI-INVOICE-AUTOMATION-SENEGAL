cat > backend/.env.example << 'EOF'
# Database
DATABASE_URL=postgresql://saisie_dev:dev_password@localhost:5432/saisie_auto_db

# ML Engine
ML_ENGINE_URL=http://localhost:8001

# OCR Provider
OCR_PROVIDER=google  # google, aws, paddle

# Google Document AI
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_PROCESSOR_ID=your-processor-id

# AWS Textract (optional)
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=us-east-1

# Security
API_KEY_SECRET=change-this-to-random-secret-key
JWT_SECRET=change-this-to-another-random-secret

# File Storage
UPLOAD_DIR=/app/data/uploads
REPORTS_DIR=/app/data/reports
MAX_UPLOAD_SIZE_MB=10

# Logging
LOG_LEVEL=INFO

# Sentry (optional)
SENTRY_DSN=
EOF
